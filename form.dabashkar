<!DOCTYPE html>
<html lang="ku" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>سیستمی ڕاپۆرت و سایەق</title>
    
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <meta name="apple-mobile-web-app-title" content="ڕاپۆرتی دابەشکار">
    <meta name="theme-color" content="#0b2997">
    <link rel="manifest" href="data:application/manifest+json;charset=utf-8,{
        %22name%22: %22سیستمی ڕاپۆرتی دابەشکار%22,
        %22short_name%22: %22ڕاپۆرت%22,
        %22start_url%22: %22.%22,
        %22display%22: %22standalone%22,
        %22background_color%22: %22#e7e9f5%22,
        %22theme_color%22: %22#0b2997%22,
        %22icons%22: [
            {
                %22src%22: %22https://cdn-icons-png.flaticon.com/512/3067/3067451.png%22,
                %22sizes%22: %22512x512%22,
                %22type%22: %22image/png%22
            }
        ]
    }">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            font-family: 'Poppins', sans-serif;
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            position: relative;
            min-height: 100vh;
            width: 100%;
            background: #e7e9f5;
            color: #333;
        }

        .sidebar {
            position: fixed;
            top: 0;
            right: 0;
            width: 78px;
            height: 100%;
            background: #ffffff;
            padding: 6px 14px;
            box-shadow: -5px 0 30px rgba(0, 0, 0, 0.1);
            transition: all 0.4s ease;
            overflow-x: hidden;
            z-index: 1000;
        }

        .sidebar:hover, .sidebar.active {
            width: 250px;
        }

        .sidebar .logo_content .logo {
            display: flex;
            align-items: center;
            width: 100%;
            height: 50px;
            margin-top: 10px;
            color: #0b2997;
            text-decoration: none;
        }

        .sidebar .logo_content .logo i {
            font-size: 28px;
            min-width: 50px;
            text-align: center;
        }

        .sidebar .logo_content .logo .logo_name {
            font-size: 18px;
            font-weight: 600;
            opacity: 0;
            transition: all 0.4s ease;
            white-space: nowrap;
        }

        .sidebar:hover .logo_content .logo .logo_name,
        .sidebar.active .logo_content .logo .logo_name {
            opacity: 1;
        }

        .sidebar ul {
            margin-top: 20px;
            list-style: none;
        }

        .sidebar ul li {
            position: relative;
            height: 50px;
            width: 100%;
            margin: 10px 0;
            line-height: 50px;
        }

        .sidebar ul li a {
            display: flex;
            align-items: center;
            text-decoration: none;
            border-radius: 12px;
            transition: all 0.3s ease;
            color: #707070;
            white-space: nowrap;
            width: 100%;
            height: 100%;
            cursor: pointer;
        }

        .sidebar ul li a:hover, .sidebar ul li.active-menu a {
            background: #0b2997;
            color: #fff;
        }

        .sidebar ul li a:hover i, .sidebar ul li.active-menu a i,
        .sidebar ul li a:hover .link_name, .sidebar ul li.active-menu a .link_name {
            color: #fff;
        }

        .sidebar ul li i {
            height: 50px;
            min-width: 50px;
            line-height: 50px;
            text-align: center;
            font-size: 18px;
            color: #707070;
            transition: all 0.3s ease;
        }

        .sidebar ul li .link_name {
            opacity: 0;
            pointer-events: none;
            transition: all 0.4s ease;
            font-size: 14px;
            font-weight: 500;
            color: #707070;
        }

        .sidebar:hover ul li .link_name,
        .sidebar.active ul li .link_name {
            opacity: 1;
            pointer-events: auto;
        }

        .main-content {
            margin-right: 90px;
            padding: 20px;
            transition: all 0.4s ease;
            width: calc(100% - 90px);
        }

        .section-view {
            display: none;
        }

        .section-view.active-view {
            display: block;
        }

        .dashboard-container {
            width: 100%;
            background: #fff;
            padding: 20px;
            border-radius: 14px;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
            border: 1px solid #eaeaea;
        }

        .dashboard-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 20px;
            border-bottom: 2px solid #f0f0f0;
            padding-bottom: 15px;
            flex-wrap: wrap;
            gap: 15px;
        }

        .dashboard-header h2 {
            color: #333;
            font-size: 18px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .header-actions {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
        }

        .btn {
            background-color: #0b2997;
            color: white;
            border: none;
            padding: 10px 18px;
            border-radius: 10px;
            font-size: 13px;
            font-weight: 500;
            cursor: pointer;
            transition: all 0.3s ease;
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .btn:hover {
            background-color: #092078;
            transform: translateY(-1px);
        }

        .btn-success { background-color: #2e7d32; }
        .btn-success:hover { background-color: #256428; }
        .btn-secondary { background-color: #6c757d; }
        .btn-secondary:hover { background-color: #5a6268; }
        .btn-warning { background-color: #d97706; color: white; }
        .btn-warning:hover { background-color: #b45309; }
        .btn-info { background-color: #0284c7; color: white; }
        .btn-info:hover { background-color: #0369a1; }
        .btn-edit-mode { background-color: #7c3aed; color: white; }
        .btn-edit-mode:hover { background-color: #6d28d9; }
        .btn-edit-active { background-color: #dc2626 !important; }

        input, select {
            padding: 9px 14px;
            border: 1px solid #ddd;
            border-radius: 10px;
            font-size: 13px;
            outline: none;
            background: #fcfcfc;
            color: #333;
            transition: all 0.3s ease;
            width: 100%;
        }

        input:focus {
            border-color: #0b2997;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(11, 41, 151, 0.1);
        }

        .report-filters {
            display: flex;
            gap: 12px;
            margin-bottom: 15px;
            flex-wrap: wrap;
            background: #f8f9fe;
            padding: 15px;
            border-radius: 12px;
            border: 1px solid #e2e8f0;
            align-items: flex-end;
        }

        .filter-group {
            flex: 1;
            min-width: 160px;
            display: flex;
            flex-direction: column;
            gap: 5px;
        }

        .filter-group label {
            font-size: 12px;
            font-weight: 500;
            color: #4b5563;
        }

        .cards-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
            gap: 15px;
            padding: 5px 0;
        }

        .trip-card {
            background: #f8f9fe;
            border: 2px solid #0b2997;
            border-radius: 12px;
            padding: 16px 18px;
            box-shadow: 0 4px 10px rgba(11, 41, 151, 0.08);
            transition: transform 0.2s ease, box-shadow 0.2s ease;
            cursor: pointer;
        }

        .trip-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 15px rgba(11,41,151,0.15);
            background: #f0f3ff;
        }

        .trip-card-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 12px;
            border-bottom: 1px solid #d2d6dc;
            padding-bottom: 8px;
        }

        .trip-card-driver {
            font-weight: 600;
            font-size: 14px;
            color: #0b2997;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .trip-card-time {
            font-size: 11px;
            background: #e2e8f0;
            color: #4a5568;
            padding: 3px 8px;
            border-radius: 6px;
            font-weight: 500;
        }

        .trip-card-body {
            font-size: 13px;
            color: #555;
            display: flex;
            flex-direction: column;
            gap: 6px;
        }

        .trip-card-body div {
            display: flex;
            justify-content: flex-end;
        }

        .trip-card-body span.val {
            font-weight: 500;
            color: #2d3748;
            width: 100%;
            text-align: right;
            padding: 2px 0;
            border-bottom: 1px dashed #e2e8f0;
        }

        .table-responsive {
            width: 100%;
            overflow-x: auto;
            margin-top: 15px;
            border-radius: 10px;
            border: 1px solid #eaeaea;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            text-align: right;
            font-size: 13px;
            background: #fff;
            white-space: nowrap;
        }

        .data-table th, .data-table td {
            padding: 12px 15px;
            border-bottom: 1px solid #eee;
        }

        .data-table th {
            background-color: #0b2997;
            color: white;
            font-weight: 500;
        }

        .data-table tr:hover {
            background-color: #f8f9fe;
        }

        .editable-cell {
            background-color: #fef3c7 !important;
            border: 1px dashed #d97706 !important;
            padding: 4px 6px !important;
            border-radius: 6px;
            outline: none;
            width: 100%;
        }

        .summary-box {
            display: flex;
            gap: 15px;
            margin-bottom: 15px;
            flex-wrap: wrap;
        }

        .summary-card {
            background: #f0f3ff;
            border: 1px solid #c7d2fe;
            padding: 12px 20px;
            border-radius: 10px;
            flex: 1;
            min-width: 150px;
            display: flex;
            flex-direction: column;
            gap: 4px;
        }

        .summary-card span:first-child {
            font-size: 12px;
            color: #4b5563;
        }

        .summary-card span:last-child {
            font-size: 18px;
            font-weight: 600;
            color: #0b2997;
        }

        .modal {
            display: none;
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            background: rgba(0,0,0,0.5);
            justify-content: center;
            align-items: center;
            z-index: 2000;
            padding: 15px;
            backdrop-filter: blur(3px);
        }

        .modal-content {
            background: #fff;
            padding: 20px;
            border-radius: 16px;
            width: 100%;
            max-width: 400px;
            max-height: 90vh;
            overflow-y: auto;
            box-shadow: 0 10px 30px rgba(0,0,0,0.15);
            border: 1px solid #eaeaea;
        }

        .details-row {
            display: flex;
            justify-content: space-between;
            padding: 8px 0;
            border-bottom: 1px solid #eee;
            font-size: 13px;
        }
        .details-row span:first-child {
            color: #666;
            font-weight: 500;
        }
        .details-row span:last-child {
            color: #2d3748;
            font-weight: 600;
            text-align: left;
        }

        .column-toggle-item {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 8px 12px;
            border-bottom: 1px solid #f0f0f0;
            font-size: 13px;
            font-weight: 500;
            color: #333;
        }

        .column-toggle-item:hover {
            background: #f8f9fe;
            border-radius: 8px;
        }

        .column-toggle-item input[type="checkbox"] {
            width: 18px;
            height: 18px;
            cursor: pointer;
            accent-color: #0b2997;
        }

        .print-date-header {
            display: none;
        }

        @media print {
            @page {
                size: landscape;
                margin: 2mm 5mm 5mm 5mm;
            }

            body * {
                visibility: hidden;
            }
            #report-section, #report-section * {
                visibility: visible;
            }
            #report-section {
                position: absolute;
                top: 0;
                right: 0;
                width: 100%;
                padding: 0 !important;
                margin: 0 !important;
                border: none !important;
                box-shadow: none !important;
            }
            .header-actions, .sidebar, .dashboard-header button, .report-filters {
                display: none !important;
            }

            .dashboard-header {
                display: flex !important;
                flex-direction: row !important;
                justify-content: space-between !important;
                align-items: center !important;
                margin-bottom: 6px !important;
                padding-bottom: 4px !important;
                border-bottom: 1px solid #999 !important;
            }

            .dashboard-header h2 {
                font-size: 12px !important;
                margin: 0 !important;
            }

            .print-date-header {
                display: inline-block !important;
                font-size: 10px !important;
                font-weight: 600 !important;
                color: #000 !important;
                background: transparent !important;
                padding: 0 !important;
                margin: 0 !important;
                border: none !important;
            }

            .summary-box {
                display: flex !important;
                flex-direction: row !important;
                gap: 6px !important;
                margin-bottom: 6px !important;
            }

            .summary-card {
                padding: 4px 6px !important;
                border: 1px solid #999 !important;
                background: #f9f9f9 !important;
            }

            .summary-card span:first-child {
                font-size: 7px !important;
                color: #333 !important;
            }

            .summary-card span:last-child {
                font-size: 10px !important;
                color: #000 !important;
            }

            .data-table {
                font-size: 9px !important;
                width: 100% !important;
            }

            .data-table th, .data-table td {
                padding: 3px 5px !important;
                border: 1px solid #bbb !important;
            }
        }

        @media (max-width: 768px) {
            .sidebar {
                width: 60px;
                padding: 6px 8px;
            }
            .sidebar:hover, .sidebar.active {
                width: 220px;
            }
            .main-content {
                margin-right: 70px;
                width: calc(100% - 70px);
                padding: 10px;
            }
            .dashboard-container {
                padding: 15px;
            }
            .cards-grid {
                grid-template-columns: 1fr;
            }
        }
    </style>
</head>
<body>

    <div class="sidebar" id="sidebar">
        <div class="logo_content">
            <a href="#" class="logo">
                <i class="fa-solid fa-file-lines"></i>
                <div class="logo_name">سیستمی ڕاپۆرت و سایەق</div>
            </a>
        </div>
        
        <ul class="nav_list">
            <li class="active-menu" id="menu-dashboard">
                <a onclick="switchView('dashboard')">
                    <i class="fa-solid fa-chart-pie"></i>
                    <span class="link_name">داشبۆرد</span>
                </a>
            </li>
            <li id="menu-drivers">
                <a onclick="switchView('drivers')">
                    <i class="fa-solid fa-id-card"></i>
                    <span class="link_name">زانیاری سایەقەکان</span>
                </a>
            </li>
            <li id="menu-reports">
                <a onclick="switchView('reports')">
                    <i class="fa-solid fa-table-list"></i>
                    <span class="link_name">فۆڕمی ڕاپۆرتەکان</span>
                </a>
            </li>
        </ul>
    </div>

    <div class="main-content">
        
        <div id="dashboard-view" class="section-view active-view">
            <div class="dashboard-container">
                <div class="dashboard-header">
                    <h2>
                        <i class="fa-solid fa-route" style="color: #0b2997;"></i> گەشتی ڕاپۆرت
                    </h2>
                    <div class="header-actions">
                        <div style="display: flex; align-items: center; width: 100%; max-width: 170px;">
                            <input type="date" id="filter-date" onchange="loadRecords()">
                        </div>
                    </div>
                </div>

                <div>
                    <div class="cards-grid" id="today-cards-container"></div>
                </div>
            </div>
        </div>

        <div id="drivers-view" class="section-view">
            <div class="dashboard-container">
                <div class="dashboard-header">
                    <h2><i class="fa-solid fa-id-card" style="color: #0b2997;"></i> زانیاری سایەقەکان</h2>
                </div>
                <p style="font-size: 14px; color: #666;">ئەم بەشە تایبەتە بە لیستی سایەقەکان و زانیارییەکانیان.</p>
            </div>
        </div>

        <div id="reports-view" class="section-view">
            <div class="dashboard-container" id="report-section">
                <div class="dashboard-header">
                    <h2>
                        <i class="fa-solid fa-table-list" style="color: #0b2997;"></i> ڕاپۆڕتی دابەشکار
                    </h2>
                    <div class="print-date-header" id="print-date-display">
                        لە (بەروار) بۆ (بەروار)
                    </div>
                    <div class="header-actions">
                        <button class="btn btn-success" onclick="exportTableToExcel()"><i class="fa-solid fa-file-excel"></i> ئێکسڵ</button>
                        <button class="btn btn-edit-mode" id="edit-mode-btn" onclick="toggleEditMode()"><i class="fa-solid fa-pen-to-square"></i> تۆمار</button>
                        <button class="btn btn-info" onclick="openColumnToggleModal()"><i class="fa-solid fa-columns"></i> ستوونەکان</button>
                        <button class="btn btn-warning" onclick="window.print()"><i class="fa-solid fa-print"></i> پرێنت</button>
                    </div>
                </div>

                <div class="report-filters">
                    <div class="filter-group">
                        <label>بەرواری سەرەتایی</label>
                        <input type="date" id="report-start-date" onchange="applyReportFilters()">
                    </div>
                    <div class="filter-group">
                        <label>بەرواری کۆتایی</label>
                        <input type="date" id="report-end-date" onchange="applyReportFilters()">
                    </div>
                    <div class="filter-group">
                        <label>گەڕان</label>
                        <input type="text" id="report-search-name" placeholder="گەڕان..." oninput="applyReportFilters()">
                    </div>
                    <div class="filter-group">
                        <label>کاتی دەستپێک</label>
                        <input type="text" id="report-start-time" value="06:00" placeholder="06:00" oninput="applyReportFilters()">
                    </div>
                </div>

                <div class="summary-box">
                    <div class="summary-card">
                        <span>کۆی گشتی گەشتەکان</span>
                        <span id="sum-count">0</span>
                    </div>
                    <div class="summary-card">
                        <span>کۆی گشتی کێشی بار</span>
                        <span id="sum-weight">0</span>
                    </div>
                    <div class="summary-card">
                        <span>کۆی گشتی ژمارەی پارچە</span>
                        <span id="sum-pieces">0</span>
                    </div>
                    <div class="summary-card">
                        <span>کۆی گشتی پارەی هێنراوە</span>
                        <span id="sum-money">0</span>
                    </div>
                    <div class="summary-card">
                        <span>کۆی گشتی کات</span>
                        <span id="sum-total-time">0 کاتژمێر</span>
                    </div>
                </div>

                <div class="table-responsive">
                    <table class="data-table" id="main-report-table">
                        <thead>
                            <tr>
                                <th>ناوی سایەق</th>
                                <th>دابەشکار</th>
                                <th>مەندوب</th>
                                <th>زۆن</th>
                                <th>ئۆتۆمبێل</th>
                                <th>کێشی بار</th>
                                <th>پارچە</th>
                                <th>ژمارەی وەسڵ</th>
                                <th>بەروار</th>
                                <th>کاتی تۆمار</th>
                                <th>کاتی ناو زۆن</th>
                                <th>کاتی دەرچوون لە زۆن</th>
                                <th>کاتی گەشتنەوە</th>
                                <th>پارەی هێنراوە</th>
                                <th>کۆی کات</th>
                            </tr>
                        </thead>
                        <tbody id="report-table-body">
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

    </div>

    <div id="detailsModal" class="modal">
        <div class="modal-content" style="max-width: 480px;">
            <h3 style="margin-bottom: 15px; border-bottom: 2px solid #f0f0f0; padding-bottom: 10px; color: #0b2997;"><i class="fa-solid fa-circle-info"></i> وردەکاری تەواوی ڕاپۆرت</h3>
            <div id="details-body"></div>
            <button class="btn btn-secondary" style="width: 100%; margin-top: 20px; justify-content: center;" onclick="closeAllModals()">داخستن</button>
        </div>
    </div>

    <div id="columnModal" class="modal">
        <div class="modal-content" style="max-width: 380px;">
            <h3 style="margin-bottom: 15px; border-bottom: 2px solid #f0f0f0; padding-bottom: 10px; color: #0b2997;"><i class="fa-solid fa-columns"></i> ستوونەکان</h3>
            <div style="display: flex; flex-direction: column; gap: 4px;" id="column-checkboxes-container">
                <div class="column-toggle-item"><span>ناوی سایەق</span> <input type="checkbox" checked onchange="toggleColumn(0, this.checked)"></div>
                <div class="column-toggle-item"><span>دابەشکار</span> <input type="checkbox" checked onchange="toggleColumn(1, this.checked)"></div>
                <div class="column-toggle-item"><span>مەندوب</span> <input type="checkbox" checked onchange="toggleColumn(2, this.checked)"></div>
                <div class="column-toggle-item"><span>زۆن</span> <input type="checkbox" checked onchange="toggleColumn(3, this.checked)"></div>
                <div class="column-toggle-item"><span>ئۆتۆمبێل</span> <input type="checkbox" checked onchange="toggleColumn(4, this.checked)"></div>
                <div class="column-toggle-item"><span>کێشی بار</span> <input type="checkbox" checked onchange="toggleColumn(5, this.checked)"></div>
                <div class="column-toggle-item"><span>پارچە</span> <input type="checkbox" checked onchange="toggleColumn(6, this.checked)"></div>
                <div class="column-toggle-item"><span>ژمارەی وەسڵ</span> <input type="checkbox" checked onchange="toggleColumn(7, this.checked)"></div>
                <div class="column-toggle-item"><span>بەروار</span> <input type="checkbox" checked onchange="toggleColumn(8, this.checked)"></div>
                <div class="column-toggle-item"><span>کاتی تۆمار</span> <input type="checkbox" checked onchange="toggleColumn(9, this.checked)"></div>
                <div class="column-toggle-item"><span>کاتی ناو زۆن</span> <input type="checkbox" checked onchange="toggleColumn(10, this.checked)"></div>
                <div class="column-toggle-item"><span>کاتی دەرچوون لە زۆن</span> <input type="checkbox" checked onchange="toggleColumn(11, this.checked)"></div>
                <div class="column-toggle-item"><span>کاتی گەشتنەوە</span> <input type="checkbox" checked onchange="toggleColumn(12, this.checked)"></div>
                <div class="column-toggle-item"><span>پارەی هێنراوە</span> <input type="checkbox" checked onchange="toggleColumn(13, this.checked)"></div>
                <div class="column-toggle-item"><span>کۆی کات</span> <input type="checkbox" checked onchange="toggleColumn(14, this.checked)"></div>
            </div>
            <button class="btn btn-secondary" style="width: 100%; margin-top: 20px; justify-content: center;" onclick="closeAllModals()">داخستن</button>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>

    <script>
        const SUPABASE_URL = "https://rivwvzdjfotkjhpuwuaf.supabase.co";
        const SUPABASE_KEY = "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InJpdnd2emRqZm90a2pocHV3dWFmIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODQ5MzgzNDAsImV4cCI6MjEwMDUxNDM0MH0.kYBINRIMeKZaTyg46gM7qBRct0H5kktd2ZJiSyIp2ag";
        const supabaseClient = window.supabase.createClient(SUPABASE_URL, SUPABASE_KEY);

        let allRecordsData = [];
        let isEditMode = false;

        window.onload = function() {
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            
            const firstDayOfMonth = `${yyyy}-${mm}-01`;
            document.getElementById('report-start-date').value = firstDayOfMonth;
            document.getElementById('report-end-date').value = '';

            document.getElementById('filter-date').value = today.toISOString().split('T')[0];

            loadFromLocalStorageAndServer();
            setupRealtimeSubscription();
        }

        function switchView(viewName) {
            document.querySelectorAll('.section-view').forEach(el => el.classList.remove('active-view'));
            document.querySelectorAll('.sidebar ul li').forEach(el => el.classList.remove('active-menu'));

            if (viewName === 'dashboard') {
                document.getElementById('dashboard-view').classList.add('active-view');
                document.getElementById('menu-dashboard').classList.add('active-menu');
            } else if (viewName === 'drivers') {
                document.getElementById('drivers-view').classList.add('active-view');
                document.getElementById('menu-drivers').classList.add('active-menu');
            } else if (viewName === 'reports') {
                document.getElementById('reports-view').classList.add('active-view');
                document.getElementById('menu-reports').classList.add('active-menu');
                applyReportFilters();
            }
        }

        function loadFromLocalStorageAndServer() {
            const cached = localStorage.getItem('cached_delivery_records');
            if (cached) {
                try {
                    const parsedData = JSON.parse(cached);
                    allRecordsData = parsedData;
                    filterAndRenderRecords(parsedData);
                    applyReportFilters();
                } catch (e) {
                    console.error("هەڵە:", e);
                }
            }
            loadRecords();
        }

        async function loadRecords() {
            const container = document.getElementById('today-cards-container');
            if (!localStorage.getItem('cached_delivery_records')) {
                container.innerHTML = '<div style="color: #777; font-size: 13px; padding: 10px;">بارکردن...</div>';
            }

            let query = supabaseClient.from('delivery_records').select('*');
            const { data, error } = await query.order('record_time', { ascending: true });

            if (error) {
                console.error("هەڵە لە هێنانی داتا: ", error.message);
                return;
            }

            if (data) {
                allRecordsData = data;
                localStorage.setItem('cached_delivery_records', JSON.stringify(data));
                filterAndRenderRecords(data);
                applyReportFilters();
            }
        }

        function filterAndRenderRecords(dataList) {
            const selectedDate = document.getElementById('filter-date').value;
            const filtered = dataList.filter(item => item.record_date === selectedDate);
            renderTodayCards(filtered);
        }

        function renderTodayCards(dataList) {
            const container = document.getElementById('today-cards-container');
            container.innerHTML = '';

            if (!dataList || dataList.length === 0) {
                container.innerHTML = '<div style="color: #777; font-size: 13px; padding: 10px;">هیچ ڕاپۆرتێک لەم بەروارەدا نییە.</div>';
                return;
            }

            dataList.forEach((item) => {
                container.innerHTML += `
                    <div class="trip-card" onclick="openDetailsModalByData('${item.id}')">
                        <div class="trip-card-header">
                            <span class="trip-card-driver"><i class="fa-solid fa-user-tie"></i> ${item.driver || 'نادیار'}</span>
                            <span class="trip-card-time"><i class="fa-regular fa-clock"></i> ${item.record_time || '-'}</span>
                        </div>
                        <div class="trip-card-body">
                            <div><span class="val">دابەشکار: ${item.distributor || '-'}</span></div>
                            <div><span class="val">زۆن: ${item.zone || '-'}</span></div>
                            <div><span class="val">ئۆتۆمبێل: ${item.vehicle || '-'}</span></div>
                        </div>
                    </div>
                `;
            });
        }

        function applyReportFilters() {
            const startDate = document.getElementById('report-start-date').value;
            const endDate = document.getElementById('report-end-date').value;
            const searchName = document.getElementById('report-search-name').value.toLowerCase().trim();

            updatePrintDateHeader(startDate, endDate);

            let filtered = allRecordsData.filter(item => {
                let matchDate = true;
                if (startDate && item.record_date < startDate) matchDate = false;
                if (endDate && item.record_date > endDate) matchDate = false;

                let matchName = true;
                if (searchName) {
                    const driver = (item.driver || '').toLowerCase();
                    const distributor = (item.distributor || '').toLowerCase();
                    const delegate = (item.delegate || '').toLowerCase();
                    const zone = (item.zone || '').toLowerCase();

                    if (!driver.includes(searchName) && !distributor.includes(searchName) && !delegate.includes(searchName) && !zone.includes(searchName)) {
                        matchName = false;
                    }
                }
                return matchDate && matchName;
            });

            renderReportTable(filtered);
        }

        function updatePrintDateHeader(start, end) {
            let startStr = start ? start : "سەرەتا";
            let endStr = end ? end : "ئێستا";
            document.getElementById('print-date-display').innerText = `لە (${startStr}) بۆ (${endStr})`;
        }

        function calculateTimeDiffInMinutes(arrivalTime, startTime) {
            if (!arrivalTime || !startTime) return 0;
            try {
                let [startH, startM] = startTime.split(':').map(Number);
                let [arrH, arrM] = arrivalTime.split(':').map(Number);

                let startTotalMins = startH * 60 + startM;
                let arrTotalMins = arrH * 60 + arrM;

                let diffMins = arrTotalMins - startTotalMins;
                return diffMins > 0 ? diffMins : 0;
            } catch (e) {
                return 0;
            }
        }

        function calculateTimeDiff(arrivalTime, startTime) {
            let diffMins = calculateTimeDiffInMinutes(arrivalTime, startTime);
            if (diffMins === 0) return '-';
            let h = Math.floor(diffMins / 60);
            let m = diffMins % 60;
            return `${h} کاتژمێر و ${m} خولەک`;
        }

        function renderReportTable(dataList) {
            const tableBody = document.getElementById('report-table-body');
            tableBody.innerHTML = '';

            if (!dataList || dataList.length === 0) {
                tableBody.innerHTML = '<tr><td colspan="15" style="text-align: center; color: #777;">هیچ داتایەک نەدۆزراوەتەوە.</td></tr>';
                document.getElementById('sum-count').innerText = 0;
                document.getElementById('sum-weight').innerText = 0;
                document.getElementById('sum-pieces').innerText = 0;
                document.getElementById('sum-money').innerText = 0;
                document.getElementById('sum-total-time').innerText = "0 کاتژمێر";
                return;
            }

            const startTime = document.getElementById('report-start-time').value || '06:00';
            let totalCount = dataList.length;
            let totalWeight = 0;
            let totalPieces = 0;
            let totalMoney = 0;
            let totalMinutesSum = 0;

            let driverTripCounter = {};

            dataList.forEach(item => {
                totalWeight += Number(item.cargo_weight || 0);
                totalPieces += Number(item.pieces_count || 0);
                totalMoney += Number(item.collected_money || 0);

                let driverName = item.driver || 'نادیار';
                if (!driverTripCounter[driverName]) {
                    driverTripCounter[driverName] = 1;
                } else {
                    driverTripCounter[driverName]++;
                }

                let timeDiffText = '-';
                if (driverTripCounter[driverName] === 1) {
                    let mins = calculateTimeDiffInMinutes(item.arrival_time, startTime);
                    totalMinutesSum += mins;
                    timeDiffText = calculateTimeDiff(item.arrival_time, startTime);
                } else {
                    timeDiffText = 'گەشتی ' + driverTripCounter[driverName] + ' (بێژمێر)';
                }

                tableBody.innerHTML += `
                    <tr data-id="${item.id}">
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'driver')">${item.driver || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'distributor')">${item.distributor || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'delegate')">${item.delegate || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'zone')">${item.zone || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'vehicle')">${item.vehicle || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'cargo_weight')">${item.cargo_weight ?? 0}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'pieces_count')">${item.pieces_count ?? 0}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'receipt_number')">${item.receipt_number ?? 0}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'record_date')">${item.record_date || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'record_time')">${item.record_time || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'in_zone_time')">${item.in_zone_time || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'out_zone_time')">${item.out_zone_time || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'arrival_time')">${item.arrival_time || '-'}</td>
                        <td contenteditable="${isEditMode}" class="${isEditMode ? 'editable-cell' : ''}" onblur="updateField(this, '${item.id}', 'collected_money')">${item.collected_money ?? 0}</td>
                        <td style="color: #0b2997; font-weight: 600;">${timeDiffText}</td>
                    </tr>
                `;
            });

            let totalH = Math.floor(totalMinutesSum / 60);
            let totalM = totalMinutesSum % 60;

            document.getElementById('sum-count').innerText = totalCount;
            document.getElementById('sum-weight').innerText = totalWeight.toLocaleString();
            document.getElementById('sum-pieces').innerText = totalPieces.toLocaleString();
            document.getElementById('sum-money').innerText = totalMoney.toLocaleString();
            document.getElementById('sum-total-time').innerText = `${totalH} کاتژمێر و ${totalM} خولەک`;
        }

        function toggleEditMode() {
            isEditMode = !isEditMode;
            const btn = document.getElementById('edit-mode-btn');
            if (isEditMode) {
                btn.classList.add('btn-edit-active');
                btn.innerHTML = '<i class="fa-solid fa-check"></i> کۆتایی تۆمار';
            } else {
                btn.classList.remove('btn-edit-active');
                btn.innerHTML = '<i class="fa-solid fa-pen-to-square"></i> تۆمار';
            }
            applyReportFilters();
        }

        async function updateField(element, id, fieldName) {
            let newValue = element.innerText.trim();
            
            // نوێکردنەوە لە لیستی لۆکاڵی
            const item = allRecordsData.find(i => String(i.id) === String(id));
            if (item) {
                item[fieldName] = newValue;
                localStorage.setItem('cached_delivery_records', JSON.stringify(allRecordsData));
            }

            // نوێکردنەوە لە پایەبەییس (Supabase)
            const { error } = await supabaseClient
                .from('delivery_records')
                .update({ [fieldName]: newValue })
                .eq('id', id);

            if (error) {
                console.error("هەڵە لە نوێکردنەوەی داتا لە سەببەیس:", error.message);
                alert("هەڵە ڕوویدا لە پاشەکەوتکردنی گۆڕانکارییەکە!");
            }
        }

        function toggleColumn(colIndex, show) {
            const table = document.getElementById('main-report-table');
            for (let row of table.rows) {
                if (row.cells[colIndex]) {
                    row.cells[colIndex].style.display = show ? '' : 'none';
                }
            }
        }

        function exportTableToExcel() {
            let csv = [];
            let rows = document.querySelectorAll(".data-table tr");
            for (let i = 0; i < rows.length; i++) {
                let row = [], cols = rows[i].querySelectorAll("td, th");
                for (let j = 0; j < cols.length; j++) {
                    if (cols[j].style.display !== 'none') {
                        row.push('"' + cols[j].innerText + '"');
                    }
                }
                csv.push(row.join(","));
            }

            let csvFile = new Blob(["\uFEFF" + csv.join("\n")], { type: "text/csv;charset=utf-8;" });
            let downloadLink = document.createElement("a");
            downloadLink.download = "Delivery_Reports.csv";
            downloadLink.href = window.URL.createObjectURL(csvFile);
            downloadLink.style.display = "none";
            document.body.appendChild(downloadLink);
            downloadLink.click();
            document.body.removeChild(downloadLink);
        }

        function setupRealtimeSubscription() {
            supabaseClient
                .channel('public:delivery_records')
                .on('postgres_changes', { event: '*', schema: 'public', table: 'delivery_records' }, payload => {
                    loadRecords();
                })
                .subscribe();
        }

        function openColumnToggleModal() {
            document.getElementById('columnModal').style.display = 'flex';
        }

        function openDetailsModalByData(id) {
            const item = allRecordsData.find(i => String(i.id) === String(id));
            if (!item) return;

            const detailsBody = document.getElementById('details-body');
            detailsBody.innerHTML = `
                <div class="details-row"><span>ناوی سایەق:</span> <span>${item.driver || '-'}</span></div>
                <div class="details-row"><span>دابەشکار:</span> <span>${item.distributor || '-'}</span></div>
                <div class="details-row"><span>مەندوب:</span> <span>${item.delegate || '-'}</span></div>
                <div class="details-row"><span>زۆن:</span> <span>${item.zone || '-'}</span></div>
                <div class="details-row"><span>ئۆتۆمبێل:</span> <span>${item.vehicle || '-'}</span></div>
                <div class="details-row"><span>کێشی بار:</span> <span>${item.cargo_weight ?? 0}</span></div>
                <div class="details-row"><span>ژمارەی پارچە:</span> <span>${item.pieces_count ?? 0}</span></div>
                <div class="details-row"><span>ژمارەی وەسڵ:</span> <span>${item.receipt_number ?? 0}</span></div>
                <div class="details-row"><span>بەروار:</span> <span>${item.record_date || '-'}</span></div>
                <div class="details-row"><span>کاتی تۆمارکردن:</span> <span>${item.record_time || '-'}</span></div>
                <div class="details-row"><span>کاتی ناو زۆن:</span> <span style="color: #2563eb;">${item.in_zone_time || 'تۆمار نەکراوە'}</span></div>
                <div class="details-row"><span>کاتی دەرچوون لە زۆن:</span> <span style="color: #d97706;">${item.out_zone_time || 'تۆمار نەکراوە'}</span></div>
                <div class="details-row"><span>کاتی گەشتنەوە:</span> <span style="color: #2e7d32;">${item.arrival_time || 'تۆمار نەکراوە'}</span></div>
                <div class="details-row" style="border-bottom: none;"><span>پارەی هێنراوە:</span> <span>${item.collected_money ?? 0}</span></div>
            `;

            document.getElementById('detailsModal').style.display = 'flex';
        }

        function closeAllModals() {
            document.getElementById('detailsModal').style.display = 'none';
            document.getElementById('columnModal').style.display = 'none';
        }
    </script>
</body>
</html>
